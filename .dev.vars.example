# Copy to .dev.vars for local testing with `npm run dev:full` (never commit .dev.vars).
# In production, set these in Cloudflare Pages → Settings → Variables and Secrets (as encrypted secrets).
GOOGLE_SERVICE_ACCOUNT_EMAIL="rsvp-writer@your-project-id.iam.gserviceaccount.com"
# Paste the private_key value from the service-account JSON, keeping the \n escapes, inside double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_KEY\n-----END PRIVATE KEY-----\n"
# The long ID in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID="your-spreadsheet-id"
# Optional; defaults to "RSVP Responses"
GOOGLE_SHEET_TAB="RSVP Responses"
