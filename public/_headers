# Hashed build output (JS/CSS) never changes for a given filename.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Photos/audio keep fixed names so the owner can replace them; cache for a day.
/assets/*
  Cache-Control: public, max-age=86400

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
